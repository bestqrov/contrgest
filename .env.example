# ============================================================
# Field Operations Control System — Environment Variables
# Copy to .env and fill all CHANGE_ME values before deploying
# Generate secrets with: bash scripts/generate-secrets.sh
# ============================================================

# --- Node ---
NODE_ENV=production

# --- PostgreSQL ---
DATABASE_URL=postgresql://fieldops:CHANGE_ME_STRONG_PASSWORD@postgres:5432/fieldops_db
DB_HOST=postgres
DB_PORT=5432
DB_NAME=fieldops_db
DB_USER=fieldops
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# --- Redis ---
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# --- MinIO (Object Storage — evidence vault + APK hosting) ---
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=CHANGE_ME_MINIO_ACCESS_KEY
MINIO_SECRET_KEY=CHANGE_ME_MINIO_SECRET_KEY_MIN_16_CHARS
MINIO_EVIDENCE_BUCKET=fieldops-evidence
MINIO_APK_BUCKET=fieldops-apk
# Public URL for APK download (used in QR provisioning payload)
MINIO_PUBLIC_URL=https://cdn.yourcompany.ma

# --- API Service ---
API_PORT=4000
API_HOST=0.0.0.0
JWT_SECRET=CHANGE_ME_64_CHAR_RANDOM_SECRET_GENERATE_WITH_OPENSSL_RAND_HEX_64
JWT_REFRESH_SECRET=CHANGE_ME_64_CHAR_REFRESH_SECRET_GENERATE_WITH_OPENSSL_RAND_HEX_64
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=12
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=100

# --- Dashboard Auth (NextAuth v5 — single owner account) ---
NEXT_PUBLIC_API_URL=https://api.yourcompany.ma
NEXTAUTH_URL=https://dashboard.yourcompany.ma
NEXTAUTH_SECRET=CHANGE_ME_NEXTAUTH_SECRET_32_CHARS_MIN
DASHBOARD_PORT=3000
# Owner credentials (OWNER_PASSWORD_HASH = bcrypt hash, generate with: node -e "console.log(require('bcryptjs').hashSync('yourpassword', 12))")
OWNER_EMAIL=owner@yourcompany.ma
OWNER_PASSWORD_HASH=CHANGE_ME_BCRYPT_HASH_OF_OWNER_PASSWORD

# --- Evolution API (WhatsApp — self-hosted) ---
EVOLUTION_API_URL=http://evolution-api:8080
EVOLUTION_API_KEY=CHANGE_ME_EVOLUTION_API_KEY
EVOLUTION_INSTANCE_NAME=fieldops-main
WHATSAPP_LOGGER_PORT=4001
WHATSAPP_WEBHOOK_SECRET=CHANGE_ME_WEBHOOK_HMAC_SECRET_32_CHARS
# Owner WhatsApp JID — receives all alerts
WHATSAPP_OWNER_JID=212XXXXXXXXX@s.whatsapp.net

# --- Content Guard ---
CONTENT_GUARD_PORT=4002
MAX_CONTENT_FILE_SIZE_MB=500
ALLOWED_CONTENT_MIME_TYPES=video/mp4,video/quicktime,image/jpeg,image/png,image/webp
# Secret for signing publish tokens (JWT, expires 2h after content approval)
CONTENT_TOKEN_SECRET=CHANGE_ME_64_CHAR_CONTENT_TOKEN_SECRET

# --- Evidence Vault ---
EVIDENCE_VAULT_PORT=4003
EVIDENCE_RETENTION_DAYS=365

# --- GPS Engine ---
GPS_ENGINE_PORT=4004
GPS_BATCH_INTERVAL_MS=30000
GPS_ANOMALY_SPEED_THRESHOLD_KMH=150
GPS_GEOFENCE_CHECK_INTERVAL_MS=60000
GPS_STOP_ANOMALY_MINUTES=20
GPS_OFFLINE_THRESHOLD_MINUTES=15
GPS_WORK_HOURS_START=8
GPS_WORK_HOURS_END=19

# --- MDM Service ---
MDM_SERVICE_PORT=4005
MDM_ENROLLMENT_TOKEN_EXPIRES_HOURS=24
MDM_POLICY_UPDATE_INTERVAL_MS=300000
# Android Enterprise QR Provisioning
AGENT_PACKAGE_NAME=ma.yourcompany.fieldops
AGENT_APK_CHECKSUM=CHANGE_ME_BASE64URL_SHA256_OF_APK_SIGNING_CERT
PROVISIONING_WIFI_SSID=FieldOps-Corp
PROVISIONING_WIFI_PASSWORD=CHANGE_ME_WIFI_PASSWORD

# --- Alert Engine ---
ALERT_ENGINE_PORT=4006
ALERT_CHECK_INTERVAL_MS=60000
ALERT_ESCALATION_TIMEOUT_MINUTES=30

# --- Creator Module ---
CREATOR_MODULE_PORT=4007
CREATOR_COMMISSION_CALCULATION_DAY=28
INTEGRITY_BONUS_RATE=0.05

# --- Email Notifications (optional, fallback to WhatsApp) ---
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
SMTP_USER=alerts@yourcompany.ma
SMTP_PASS=CHANGE_ME_SMTP_PASSWORD
ALERT_EMAIL_FROM=alerts@yourcompany.ma
ALERT_EMAIL_TO=owner@yourcompany.ma

# --- Coolify / Hostinger VPS ---
DOMAIN=yourcompany.ma
VPS_IP=YOUR_VPS_IP

# --- Logging ---
LOG_LEVEL=info
LOG_FORMAT=json

# --- Internal Service URLs (docker-compose service names) ---
API_INTERNAL_URL=http://api:4000
WHATSAPP_LOGGER_INTERNAL_URL=http://whatsapp-logger:4001
CONTENT_GUARD_INTERNAL_URL=http://content-guard:4002
EVIDENCE_VAULT_INTERNAL_URL=http://evidence-vault:4003
GPS_ENGINE_INTERNAL_URL=http://gps-engine:4004
MDM_SERVICE_INTERNAL_URL=http://mdm-service:4005
ALERT_ENGINE_INTERNAL_URL=http://alert-engine:4006
CREATOR_MODULE_INTERNAL_URL=http://creator-module:4007

# --- Internal Service Secret (HMAC for inter-service calls) ---
INTERNAL_SERVICE_SECRET=CHANGE_ME_INTERNAL_SERVICE_SECRET_64_CHARS

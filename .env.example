# --- API Service ---
API_PORT=4000
API_HOST=0.0.0.0
JWT_SECRET=CHANGE_ME_64_CHAR_RANDOM_SECRET_HERE_GENERATE_WITH_OPENSSL
JWT_REFRESH_SECRET=CHANGE_ME_64_CHAR_REFRESH_SECRET_HERE_GENERATE_WITH_OPENSSL
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=12
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=100

# --- Dashboard (Next.js) ---
NEXT_PUBLIC_API_URL=https://api.yourcompany.ma
NEXTAUTH_URL=https://dashboard.yourcompany.ma
NEXTAUTH_SECRET=CHANGE_ME_NEXTAUTH_SECRET_32_CHARS
DASHBOARD_PORT=3000

# --- Evolution API (WhatsApp) ---
EVOLUTION_API_URL=http://evolution-api:8080
EVOLUTION_API_KEY=CHANGE_ME_EVOLUTION_API_KEY
EVOLUTION_INSTANCE_NAME=fieldops-main
WHATSAPP_LOGGER_PORT=4001
WHATSAPP_WEBHOOK_SECRET=CHANGE_ME_WEBHOOK_HMAC_SECRET

# --- Content Guard ---
CONTENT_GUARD_PORT=4002
CONTENT_APPROVAL_WEBHOOK_URL=https://api.yourcompany.ma/webhooks/content
MAX_CONTENT_FILE_SIZE_MB=500
ALLOWED_CONTENT_MIME_TYPES=video/mp4,video/quicktime,image/jpeg,image/png,image/webp

# --- Evidence Vault ---
EVIDENCE_VAULT_PORT=4003
EVIDENCE_STORAGE_PATH=/data/evidence
EVIDENCE_MAX_FILE_SIZE_MB=1024
EVIDENCE_RETENTION_DAYS=365
# Optional: S3-compatible storage (MinIO / Cloudflare R2)
S3_ENDPOINT=https://s3.yourprovider.com
S3_BUCKET=field-ops-evidence
S3_ACCESS_KEY=CHANGE_ME_S3_ACCESS_KEY
S3_SECRET_KEY=CHANGE_ME_S3_SECRET_KEY
S3_REGION=us-east-1

# --- GPS Engine ---
GPS_ENGINE_PORT=4004
GPS_BATCH_INTERVAL_MS=30000
GPS_ANOMALY_SPEED_THRESHOLD_KMH=150
GPS_GEOFENCE_CHECK_INTERVAL_MS=60000

# --- MDM Service ---
MDM_SERVICE_PORT=4005
MDM_ENROLLMENT_TOKEN_EXPIRES_HOURS=48
ANDROID_ENTERPRISE_SERVICE_ACCOUNT_JSON={"type":"service_account"}
MDM_POLICY_UPDATE_INTERVAL_MS=300000

# --- Alert Engine ---
ALERT_ENGINE_PORT=4006
ALERT_CHECK_INTERVAL_MS=60000
ALERT_ESCALATION_TIMEOUT_MINUTES=30

# --- Creator Module ---
CREATOR_MODULE_PORT=4007
TIKTOK_API_KEY=CHANGE_ME_TIKTOK_API_KEY
INSTAGRAM_API_KEY=CHANGE_ME_INSTAGRAM_API_KEY
CREATOR_COMMISSION_CALCULATION_DAY=28

# --- Notifications ---
WHATSAPP_OWNER_JID=212XXXXXXXXX@s.whatsapp.net
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
SMTP_USER=alerts@yourcompany.ma
SMTP_PASS=CHANGE_ME_SMTP_PASSWORD
ALERT_EMAIL_FROM=alerts@yourcompany.ma
ALERT_EMAIL_TO=owner@yourcompany.ma

# --- Coolify / Hostinger VPS ---
DOMAIN=yourcompany.ma
TRAEFIK_ACME_EMAIL=admin@yourcompany.ma
VPS_IP=YOUR_VPS_IP

# --- Logging ---
LOG_LEVEL=info
LOG_FORMAT=json

# --- Internal Service URLs (used for inter-service calls) ---
API_INTERNAL_URL=http://api:4000
WHATSAPP_LOGGER_INTERNAL_URL=http://whatsapp-logger:4001
CONTENT_GUARD_INTERNAL_URL=http://content-guard:4002
EVIDENCE_VAULT_INTERNAL_URL=http://evidence-vault:4003
GPS_ENGINE_INTERNAL_URL=http://gps-engine:4004
MDM_SERVICE_INTERNAL_URL=http://mdm-service:4005
ALERT_ENGINE_INTERNAL_URL=http://alert-engine:4006
CREATOR_MODULE_INTERNAL_URL=http://creator-module:4007

# --- Internal Service Secret (shared HMAC for inter-service auth) ---
INTERNAL_SERVICE_SECRET=CHANGE_ME_INTERNAL_SERVICE_SECRET_64_CHARS
